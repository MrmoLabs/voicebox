{
  "name": "dsh-voicebox",
  "version": "0.2.0-beta.2",
  "description": "Hands-free voice conversations and streaming reply narration for DeepSeek Harness through local Voicebox.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "src/*.js",
    "lib",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "VERIFICATION.md",
    "DESIGN-voice-interaction.md",
    "INSTALL.md",
    "ROADMAP.md",
    "third-party"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "bun run build",
    "verify:package": "bun scripts/verify-package.mjs",
    "verify:dsh": "node scripts/verify-dsh-install.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "opencc-js": "1.4.2",
    "thinking-orbs": "0.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "voicebox",
    "text-to-speech"
  ],
  "license": "MIT"
}
